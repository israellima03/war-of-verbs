---
// /aprender tiene 2 formas de estudiar, con los mismos filtros:
//   - Tarjetas: ver todos los verbos.
//   - Transcribir: copiar cada verbo varias veces y luego escribirlo de memoria.
import Layout from "../layouts/Layout.astro";
import VerbCard from "../components/VerbCard.astro";
import VerbFilters from "../components/VerbFilters.astro";
import TranscribeTrainer from "../components/TranscribeTrainer.astro";
import { verbs } from "../data/verbs";
---

<Layout
  title="Aprender"
  description="Estudia verbos regulares e irregulares en inglés."
>
  <section class="bg-slate-950 px-6 py-16">
    <div class="mx-auto max-w-6xl">

      <div class="text-center">
        <h1 class="text-3xl font-extrabold text-slate-100 sm:text-4xl">
          Aprender Verbos
        </h1>
        <p class="mt-3 text-slate-400">
          Mira las tarjetas o transcribe los verbos hasta aprenderlos de memoria.
        </p>

        <!-- ELEGIR FORMA DE ESTUDIAR -->
        <div id="view-options" class="mt-6 inline-flex gap-2">
          <button type="button" data-value="cards" class="chip active">Tarjetas</button>
          <button type="button" data-value="transcribe" class="chip">Transcribir</button>
        </div>
      </div>

      <!-- FILTROS (sirven para las dos formas) -->
      <div class="mt-10">
        <VerbFilters />
      </div>

      <!-- VISTA 1: TARJETAS -->
      <div id="cards-view">
        <div id="verb-list" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {verbs.map((verb) => <VerbCard verb={verb} />)}
        </div>
        <p id="empty-msg" class="mt-10 hidden text-center text-red-400">
          No hay verbos con estos filtros.
        </p>
      </div>

      <!-- VISTA 2: TRANSCRIBIR -->
      <div id="transcribe-view" class="mt-10 hidden">
        <TranscribeTrainer />
      </div>

    </div>
  </section>
</Layout>

<script>
  // Este código corre en el navegador (no en el servidor de Astro).
  import { matchesLessons } from "../data/lessons";
  import type { Mode, TypeFilter } from "../data/questions";
  import { setupChips, setupLessonPicker, showVerbCount } from "../scripts/filters";
  import { setupTranscribe } from "../scripts/transcribe";

  const cards = document.querySelectorAll<HTMLElement>(".verb-card");
  const emptyMsg = document.getElementById("empty-msg")!;
  const cardsView = document.getElementById("cards-view")!;
  const transcribeView = document.getElementById("transcribe-view")!;

  let currentType: TypeFilter = "all";
  let currentMode: Mode = "3";
  let currentLessons: number[] = []; // [] = todas

  // El modo Transcribir lee los filtros con esta función.
  const transcribe = setupTranscribe(() => ({
    type: currentType,
    mode: currentMode,
    lessons: currentLessons,
  }));

  // Tarjetas <-> Transcribir
  setupChips("view-options", (value) => {
    cardsView.classList.toggle("hidden", value !== "cards");
    transcribeView.classList.toggle("hidden", value !== "transcribe");
  });

  setupChips("type-options", (value) => {
    currentType = value as TypeFilter;
    applyFilters();
    transcribe.onListChange();
  });
  setupChips("mode-options", (value) => {
    currentMode = value as Mode;
    applyFilters();
    transcribe.onModeChange();
  });
  setupLessonPicker((selected) => {
    currentLessons = selected;
    applyFilters();
    transcribe.onListChange();
  });

  // Muestra u oculta las tarjetas según los filtros.
  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      // --- Filtro por tipo y por lección ---
      // data-lessons trae algo como "3 4"; lo convertimos a [3, 4].
      const cardLessons = (card.dataset.lessons ?? "").split(" ").map(Number);
      const show =
        (currentType === "all" || card.dataset.type === currentType) &&
        matchesLessons(cardLessons, currentLessons);
      card.classList.toggle("hidden", !show);
      if (show) visible++;

      // --- Filtro por cantidad de formas ---
      const participleField = card.querySelector(".participle-field");
      const fieldsGrid = card.querySelector(".verb-fields");

      if (participleField && fieldsGrid) {
        const show4Forms = currentMode === "4";
        participleField.classList.toggle("hidden", !show4Forms);
        // 4 formas en una tarjeta angosta no caben en una fila: usamos 2x2.
        fieldsGrid.classList.toggle("grid-cols-3", !show4Forms);
        fieldsGrid.classList.toggle("grid-cols-2", show4Forms);
      }
    });

    showVerbCount(visible);
    emptyMsg.classList.toggle("hidden", visible > 0);
  }

  // Aplicamos los filtros una vez al cargar la página.
  applyFilters();
</script>
