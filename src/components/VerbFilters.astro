---
// Panel de filtros que comparten Aprender, Practicar y Examen:
// tipo de verbo, cantidad de formas y lecciones.
// Cada página lee los clics con setupChips() y setupLessonPicker()
// de src/scripts/filters.ts, usando los ids "type-options" y "mode-options".
import LessonPicker from "./LessonPicker.astro";
---

<div class="space-y-6 rounded-2xl border border-slate-800 bg-slate-800/50 p-6">
  <div class="flex flex-col gap-6 sm:flex-row sm:gap-12">
    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-slate-400">Tipo</p>
      <div id="type-options" class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-value="all" class="chip active">Todos</button>
        <button type="button" data-value="regular" class="chip">Regulares</button>
        <button type="button" data-value="irregular" class="chip">Irregulares</button>
      </div>
    </div>
    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-slate-400">Formas</p>
      <div id="mode-options" class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-value="3" class="chip active">3 Formas</button>
        <button type="button" data-value="4" class="chip">4 Formas</button>
      </div>
    </div>
  </div>

  <LessonPicker />

  <!-- Espacio para que cada página agregue algo más (ej. el examen) -->
  <slot />
</div>
