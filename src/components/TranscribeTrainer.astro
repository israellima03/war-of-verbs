---
// Modo "Transcribir" de /aprender. Tiene 3 pantallas:
//   1) [data-tr-setup]    -> elegir cuántas veces copiar cada verbo
//   2) [data-tr-practice] -> tarjeta arriba, campos para escribir abajo
//   3) [data-tr-summary]  -> resumen final
// Este componente solo pone el HTML. La lógica está en
// src/scripts/transcribe.ts (la llama el script de aprender.astro).
const repOptions = [1, 2, 3, 4, 5];
---

<div data-transcribe>
  <!-- 1) CONFIGURACIÓN -->
  <div data-tr-setup class="mx-auto max-w-3xl rounded-2xl border border-slate-800 bg-slate-800/50 p-6 sm:p-8">
    <h2 class="text-xl font-bold text-slate-100">Transcribir</h2>
    <p class="mt-2 text-slate-400">
      Copia cada verbo varias veces (la respuesta está encima de cada campo). Al final, solo verás la
      <strong class="text-slate-100">Base Form</strong> y tendrás que escribir el resto de memoria.
    </p>

    <p class="mt-6 text-sm font-bold uppercase tracking-wider text-slate-400">Veces que copias cada verbo</p>
    <div id="reps-options" class="mt-3 flex flex-wrap gap-2">
      {repOptions.map((n) => (
        <button type="button" data-value={n} class:list={["chip", { active: n === 3 }]}>{n}</button>
      ))}
    </div>
    <p class="mt-2 text-xs text-slate-500">
      Ejemplo con 3: copias 3 veces y en la 4.ª es la prueba de memoria. Los verbos
      salen según los filtros de arriba (tipo, formas y lecciones).
    </p>

    <p data-tr-error class="mt-4 hidden text-sm font-semibold text-red-400">
      No hay verbos con estos filtros. Elige otra lección o tipo.
    </p>
    <button data-tr-start type="button" class="btn-primary mt-6 w-full">EMPEZAR A TRANSCRIBIR</button>
  </div>

  <!-- 2) PRÁCTICA -->
  <div data-tr-practice class="mx-auto hidden max-w-3xl">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p data-tr-progress class="text-sm text-slate-400"></p>
        <p data-tr-step class="text-lg font-bold"></p>
      </div>
      <button data-tr-exit type="button"
        class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-300 transition hover:border-red-500/50 hover:text-red-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
        Salir
      </button>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-800">
      <div data-tr-bar class="h-full w-0 bg-blue-500 transition-all"></div>
    </div>

    <!-- Tipo y lecciones del verbo (lo dibuja el script) -->
    <div data-tr-card class="mt-6"></div>

    <!-- Campos para transcribir -->
    <form data-tr-form class="mt-3 rounded-2xl border border-slate-800 bg-slate-800/50 p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Escribe las formas</p>
      <p class="mt-1 text-xs text-slate-500">
        Pulsa <kbd class="rounded border border-slate-700 px-1.5 text-slate-300">Enter</kbd>
        para pasar al siguiente campo. Solo avanzas si está bien escrito.
      </p>
      <div data-tr-fields class="mt-4 space-y-4"></div>
      <button data-tr-check type="submit" class="btn-primary mt-6 rounded-xl">Comprobar</button>
      <p data-tr-feedback class="mt-4 min-h-6 font-semibold"></p>
    </form>
  </div>

  <!-- 3) RESUMEN -->
  <div data-tr-summary class="mx-auto hidden max-w-3xl rounded-3xl border border-slate-800 bg-slate-800/50 p-8 text-center">
    <h2 class="text-2xl font-extrabold text-slate-100">¡Terminaste!</h2>
    <p class="mt-4 text-slate-400">Recordaste a la primera</p>
    <p class="mt-1 text-5xl font-extrabold text-blue-400">
      <span data-tr-remembered>0</span><span class="text-2xl text-slate-500">/<span data-tr-total>0</span></span>
    </p>

    <div data-tr-failed-box class="mt-8 hidden">
      <p class="text-sm font-bold uppercase tracking-wider text-red-400">Para repasar</p>
      <div data-tr-failed-list class="mt-3 flex flex-wrap justify-center gap-2"></div>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button data-tr-retry-failed type="button" class="btn-primary hidden">Repasar los que fallé</button>
      <button data-tr-restart type="button" class="btn-secondary">Empezar de nuevo</button>
    </div>
  </div>
</div>
