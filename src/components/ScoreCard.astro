---
// Tarjeta con el resultado del examen: puntuación, correctas,
// porcentaje, tiempo y cantidad de preguntas.
// Los números los rellena el script de examen.astro al terminar,
// buscando los elementos por su atributo data-*.

// Las 4 cajitas de abajo, para no repetir el mismo HTML 4 veces.
const stats = [
  { label: "Correctas", key: "correct" },
  { label: "Porcentaje", key: "percent" },
  { label: "Tiempo", key: "time" },
  { label: "Preguntas", key: "questions" },
];
---

<div class="rounded-3xl border border-slate-800 bg-slate-800/50 p-8 text-center">
  <p class="text-sm font-bold uppercase tracking-wider text-slate-400">Puntuación</p>
  <p class="mt-2 text-5xl font-extrabold text-blue-400">
    <span data-stat="score">0</span><span class="text-2xl text-slate-500">/<span data-stat="max">0</span></span>
  </p>

  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {stats.map((stat) => (
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-4">
        <p class="text-xs uppercase text-slate-500">{stat.label}</p>
        <p class="mt-1 text-xl font-bold text-slate-100" data-stat={stat.key}>-</p>
      </div>
    ))}
  </div>
</div>
