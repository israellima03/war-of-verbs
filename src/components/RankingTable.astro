---
// Tabla del ranking. Este componente dibuja solo la estructura
// (encabezados). Las filas las agrega el script de ranking.astro,
// porque dependen de los resultados guardados en el navegador.
---

<div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-800/50">
  <table class="w-full min-w-[480px] text-left text-sm">
    <thead class="border-b border-slate-800 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">#</th>
        <th class="px-4 py-3">Nombre</th>
        <th class="px-4 py-3 text-right">Puntuación</th>
        <th class="px-4 py-3 text-right">%</th>
        <th class="px-4 py-3 text-right">Tiempo</th>
      </tr>
    </thead>
    <tbody data-ranking-body class="divide-y divide-slate-800"></tbody>
  </table>
</div>
